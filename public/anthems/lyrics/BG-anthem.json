{
  "isoCode": "BG",
  "title": "Мила Родино",
  "language": {
    "code": "bg",
    "name": "Bulgarian",
    "script": "Cyrillic"
  },
  "sources": {
    "local": {
      "licence": "Public domain",
      "note": "https://en.wikipedia.org/wiki/Mila_Rodino"
    },
    "english": {
      "author": "English Wikipedia contributors",
      "licence": "CC BY-SA 4.0",
      "note": "Extracted from the English Wikipedia article cited in sources.local.note."
    }
  },
  "verses": [
    {
      "local": [
        "Горда Стара планина,",
        "до ней Дунава синей,",
        "слънце Тракия огрява,",
        "над Пирина пламеней."
      ],
      "english": [
        "The proud Stara Planina,",
        "Bluely the Danube shimmers.",
        "The Sun shines over Thrace,",
        "And over Pirin it blazes."
      ]
    },
    {
      "local": [
        "(Родино) Мила Родино,",
        "ти си земен рай,",
        "твойта хубост, твойта прелест,",
        "ах, те нямат край."
      ],
      "english": [
        "(Motherland) O dear Motherland,",
        "You're earth's Promised Land,",
        "Your beauty, your loveliness,",
        "Ah, forever boundless."
      ]
    },
    {
      "local": [
        "Паднаха борци безчет,",
        "за народа наш любим,",
        "майко, дай ни мъжка сила,",
        "пътя им да продължим."
      ],
      "english": [
        "For our people beloved,",
        "Lives martyrs have sacrificed.",
        "Mother, give us virile strength",
        "For persevering their path."
      ]
    }
  ]
}
