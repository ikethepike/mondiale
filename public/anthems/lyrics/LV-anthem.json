  "verses": [
    {
      "local": [
        "Dievs, svētī [[Latviju]]!",
        "Mūs' dārgo tēviju",
        "Svētī jel [[Latviju]]",
        "Ak, svētī jel to!"
      ],
      "english": [
        "God bless [[Latvia]]!",
        "Our beloved fatherland,",
        "Do bless [[Latvia]],",
        "O do bless it!"
      ]
    },
    {
      "local": [
        "Kur [[latvju]] meitas zied",
        "Kur [[latvju]] dēli dzied",
        "Laid mums tur laimē diet",
        "Mūs' [[Latvijā]]!"
      ],
      "english": [
        "Where [[Latvian]] daughters bloom,",
        "Where [[Latvian]] sons sing,",
        "Let us dance in happiness there,",
        "In our [[Latvia]]!"
      ]
    }
  ]
}
