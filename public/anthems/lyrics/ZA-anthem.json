      "local": [
        "Morena boloka setjhaba sa heso,",
        "O fedise dintwa le matshwenyeho,",
        "O se boloke, O se boloke setjhaba sa heso,",
        "Setjhaba sa, South [[Afrika]], South [[Afrika]]."
