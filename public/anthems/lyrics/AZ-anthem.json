  "isoCode": "AZ",
  "title": "Azərbaycan marşı",
  "language": {
    "code": "az",
    "name": "Azerbaijani",
    "script": "Arabic"
  },
  "sources": {
    "local": {
      "author": "Ahmad Javad",
