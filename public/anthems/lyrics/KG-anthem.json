{
  "isoCode": "KG",
  "title": "Кыргыз Республикасынын Мамлекеттик гимни",
  "language": {
    "code": "ky",
    "name": "Kyrgyz",
    "script": "Cyrillic"
  },
  "sources": {
    "local": {
      "licence": "Public domain",
      "note": "https://en.wikipedia.org/wiki/State_Anthem_of_the_Kyrgyz_Republic"
    },
    "english": {
      "author": "English Wikipedia contributors",
