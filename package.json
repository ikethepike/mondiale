{
  "name": "mondiale",
  "private": true,
  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=3584 nuxt build",
    "deploy": "fly deploy --strategy bluegreen --build-arg GIT_SHA=$(git rev-parse --short=7 HEAD)",
    "start": "node .output/server/index.mjs",
    "dev": "NODE_OPTIONS=--max-old-space-size=16384 nuxt dev --host=0.0.0.0",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:repro": "playwright test --config=playwright.repro.config.ts",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:countries": "bun run ./generators/create-countries-file.ts && bun run ./generators/create-flags-file.ts",
    "generate:flags": "bun run ./generators/create-flags-file.ts",
    "generate:marriage-rights": "bun run ./generators/create-marriage-rights-file.ts",
    "generate:far-flung": "bun run ./generators/create-far-flung-file.ts",
    "generate:linking": "bun run ./generators/create-link-mapping.ts",
    "generate:conflicts": "bun run generators/vendors/ucdp/create-conflicts.ts",
    "generate:conflict-events": "bun run generators/vendors/ucdp/create-conflict-events.ts",
    "generate:worldbank": "bun run generators/vendors/worldbank/create-worldbank.ts",
    "generate:owid": "bun run generators/vendors/owid/create-owid.ts",
    "generate:imf": "bun run generators/vendors/imf/create-imf.ts",
    "snapshot:factbook": "bun run generators/vendors/cia/snapshot-factbook.ts",
    "generate:commodity-exporters": "bun run generators/vendors/cepii/create-commodity-exporters.ts",
    "generate:wpp": "bun run generators/vendors/unwpp/create-wpp.ts",
    "generate:migration": "bun run generators/vendors/undesa/create-migration.ts",
    "generate:treaties": "bun run generators/vendors/untc/create-treaties.ts",
    "generate:leaders": "bun run generators/create-leaders-file.ts",
    "generate:parties": "bun run generators/create-polity-file.ts",
    "generate:capitals": "bun run generators/create-capitals-file.ts",
    "generate:anthems": "bun run generators/create-anthems-file.ts",
    "generate:anthem-lyrics": "bun run generators/create-anthem-lyrics-file.ts",
    "generate:tongues": "bun run generators/create-tongues-file.ts",
    "generate:currencies": "bun run generators/create-currencies-file.ts",
    "generate:landmarks": "bun run generators/create-landmarks-file.ts",
    "generate:events": "bun run generators/create-events-file.ts",
    "generate:changes": "bun run generators/create-change-file.ts",
    "generate:heritage": "bun run generators/create-heritage-file.ts",
    "generate:cities": "bun run generators/vendors/geonames/create-cities.ts",
    "generate:map": "bun run generators/vendors/naturalearth/create-map.ts",
    "generate:straits": "bun run generators/create-straits-file.ts",
    "generate:water": "bun run generators/vendors/naturalearth/create-water.ts && bun run generators/create-sea-lanes-file.ts",
    "generate:sea-lanes": "bun run generators/create-sea-lanes-file.ts",
    "generate:recognition": "bun run generators/vendors/naturalearth/create-recognition.ts",
    "generate:empires": "bun run generators/vendors/history/create-empires.ts",
    "generate:flags-wide": "bun run generators/flags/create-flags-wide-file.ts",
    "generate:flag-meanings": "bun run generators/create-flag-meanings-file.ts",
    "generate:capital-facts": "bun run generators/create-capital-facts-file.ts",
    "generate:name-facts": "bun run generators/create-name-facts-file.ts",
    "generate:water-facts": "bun run generators/create-water-facts-file.ts",
    "generate:tongue-facts": "bun run generators/create-tongue-facts-file.ts",
    "upscale": "bun --env-file=./.env run generators/upscale-image.ts"
  },
  "devDependencies": {
    "@google/genai": "^2.10.0",
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "^1.61.1",
    "@types/bun": "^1.3.14",
    "@types/d3-geo": "^3.1.0",
    "@types/flubber": "^0.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/he": "^1.2.3",
    "@types/node": "^24.11.0",
    "@types/sortablejs": "^1.15.9",
    "@types/three": "^0.185.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-server": "^3.0.4",
    "@types/topojson-simplify": "^3.0.3",
    "countries-list": "^3.3.0",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "fflate": "^0.8.3",
    "he": "^1.2.0",
    "nuxt": "4.4.8",
    "prettier": "^3.9.4",
    "sharp": "^0.35.3",
    "svgo": "^4.0.1",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.6"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@tresjs/cientos": "^5.8.1",
    "@tresjs/nuxt": "^5.6.3",
    "@upstash/redis": "^1.38.0",
    "alea": "^1.0.1",
    "flubber": "^0.4.2",
    "gsap": "^3.15.0",
    "pinia": "^3.0.4",
    "random-words": "^2.0.1",
    "sass": "^1.101.0",
    "simplex-noise": "^4.0.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sortablejs": "^1.15.7",
    "sortablejs-vue3": "^1.3.0",
    "three": "^0.185.1"
  }
}
