# Build artifacts & deps (rebuilt inside the image)
**/node_modules
**/.nuxt
**/.nitro
**/.cache
**/.output
**/dist

# Secrets & local env
**/.env
**/.env.*

# VCS & CI (31MB+ of .git — never needed in the image)
.git
.github
fly.toml

# Test output & local scratch
test-results
playwright-report
e2e
screenshots
docs
playwright*.config.ts
fly.preview.toml
dump.rdb
docker-compose.yml

# Generator caches and reports (app code imports a few generator .ts files, never these)
generators/**/*.json
generators/**/*.jpg
generators/**/*.txt

# Logs & OS cruft
**/*.log*
**/.DS_Store

# Claude worktrees & session files (can hold full repo copies)
.claude
